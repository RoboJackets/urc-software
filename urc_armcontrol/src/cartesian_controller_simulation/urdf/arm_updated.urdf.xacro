<?xml version="1.0"?>

<robot name="arm_gz" xmlns:xacro="http://ros.org/wiki/xacro">

        <!--
        RoboNav Arm URDF - 5 degrees of freedom
        MERGED VERSION: geometry/origins/meshes/inertials now come from the
        SolidWorks export (Simplified_Arm.SLDASM.urdf), which has correct
        joint origins matching the CAD assembly mates. The ros2_control
        block and gz_ros2_control gazebo plugin are carried over from the
        original hand-written Gazebo xacro, with joint/link names renamed
        to match controller_manager_arm.yaml (joint1..joint5, base_link,
        link1..link5, tool0).

        Joint mapping (SolidWorks name -> controller name):
          forearm_prismatic -> joint1   (base slide, prismatic)
          bicep_revolute    -> joint2   (shoulder pitch)
          forearm_revolute  -> joint3   (elbow pitch)
          diffw_pitch       -> joint4   (wrist pitch)
          diffw_yaw         -> joint5   (wrist roll)

        Link mapping:
          base_lineara -> base_link
          bicep_base   -> link1
          bicep_link   -> link2
          forearm_link -> link3
          diffw_forearm -> link4
          diffw_link   -> link5

        NOTE: joint5 axis / diffw_yaw mapping to "wrist roll" is unconfirmed —
        verify against the physical arm.

        Gripper geometry from the old xacro is kept below but commented out
        so it can be toggled back on once confirmed against the real
        end effector. A minimal, zero-offset tool0 frame is left active
        (uncommented) so cartesian controllers relying on
        end_effector_link: "tool0" don't break while the gripper is disabled.
        -->

        <xacro:include filename="$(find cartesian_controller_simulation)/urdf/joint_gz.urdf.xacro"/>

        <!-- ROS2 control interfaces -->
        <ros2_control name="cartesian_controller_simulation" type="system">

                <joint name="joint1"> <!-- base slide - prismatic -->
                        <command_interface name="position">
                                <param name="min">0</param>
                                <param name="max">0.5</param>
                        </command_interface>
                        <command_interface name="velocity">
                                <param name="min">-1</param>
                                <param name="max">1</param>
                        </command_interface>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                        <state_interface name="effort"/>
                </joint>

                <xacro:joint_interface name="joint2" /> <!-- shoulder pitch -->
                <xacro:joint_interface name="joint3" /> <!-- elbow pitch -->
                <xacro:joint_interface name="joint4" /> <!-- wrist pitch -->
                <xacro:joint_interface name="joint5" /> <!-- wrist roll -->

                <hardware>
                        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>

        </ros2_control>

        <!-- Gazebo plugin to load controller manager -->
        <gazebo>
                <plugin filename="gz_ros2_control-system"
                        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                        <parameters>$(find cartesian_controller_simulation)/config/controller_manager_arm.yaml</parameters>
                </plugin>
        </gazebo>

        <material name="base">
                <color rgba="0.79216 0.81961 0.93333 1" />
        </material>

        <!-- ================= base_link (was base_lineara) ================= -->
        <link name="base_link">
                <inertial>
                        <origin xyz="3.579E-06 0.22158 0.010673" rpy="0 0 0" />
                        <mass value="1.3141" />
                        <inertia ixx="0.034947" ixy="-1.0032E-07" ixz="-4.9223E-09"
                                 iyy="0.0025144" iyz="3.7387E-07" izz="0.037389" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/base_lineara.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/base_lineara.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- ================= link1 (was bicep_base) ================= -->
        <link name="link1">
                <inertial>
                        <origin xyz="-2.909E-05 0.072285 0.04786" rpy="0 0 0" />
                        <mass value="0.80928" />
                        <inertia ixx="0.001288" ixy="-2.9097E-08" ixz="2.9394E-09"
                                 iyy="0.0024023" iyz="-3.1525E-09" izz="0.0018264" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_base.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_base.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- joint1: base slide (was forearm_prismatic) -->
        <joint name="joint1" type="prismatic">
                <origin xyz="0 0 0.03135" rpy="0 0 0" />
                <parent link="base_link" />
                <child link="link1" />
                <axis xyz="0 1 0" />
                <limit lower="0" upper="0.5" effort="100" velocity="1.0" />
        </joint>

        <!-- ================= link2 (was bicep_link) ================= -->
        <link name="link2">
                <inertial>
                        <origin xyz="-8.0298E-05 0.028836 0.082763" rpy="0 0 0" />
                        <mass value="1.5004" />
                        <inertia ixx="0.005463" ixy="-3.5399E-07" ixz="-1.6306E-05"
                                 iyy="0.0069551" iyz="-5.814E-07" izz="0.001901" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_link.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_link.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- joint2: shoulder pitch (was bicep_revolute) -->
        <joint name="joint2" type="revolute">
                <origin xyz="0 0.076091 0.12103" rpy="0 0 0" />
                <parent link="link1" />
                <child link="link2" />
                <axis xyz="0 1 0" />
                <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="1.0" velocity="10.0" />
        </joint>

        <!-- ================= link3 (was forearm_link) ================= -->
        <link name="link3">
                <inertial>
                        <origin xyz="-0.00011008 -0.025553 0.076716" rpy="0 0 0" />
                        <mass value="1.601" />
                        <inertia ixx="0.0051728" ixy="-2.2245E-06" ixz="7.8401E-06"
                                 iyy="0.0064253" iyz="1.9188E-08" izz="0.0018615" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/forearm_link.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/forearm_link.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- joint3: elbow pitch (was forearm_revolute) -->
        <joint name="joint3" type="revolute">
                <origin xyz="-0.00050763 0.068262 0.42862" rpy="0 0 0" />
                <parent link="link2" />
                <child link="link3" />
                <axis xyz="0 1 0" />
                <limit lower="${-pi}" upper="${pi}" effort="1.0" velocity="10.0" />
        </joint>

        <!-- ================= link4 (was diffw_forearm) ================= -->
        <link name="link4">
                <inertial>
                        <origin xyz="-1.4843E-05 5.7115E-06 0.0050339" rpy="0 0 0" />
                        <mass value="0.27656" />
                        <inertia ixx="9.9333E-05" ixy="5.7444E-09" ixz="-5.0297E-08"
                                 iyy="0.00012995" iyz="5.1554E-10" izz="9.7766E-05" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_forearm.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_forearm.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- joint4: wrist pitch (was diffw_pitch) -->
        <joint name="joint4" type="revolute">
                <origin xyz="-0.00047153 -0.068263 0.39814" rpy="0 0 0" />
                <parent link="link3" />
                <child link="link4" />
                <axis xyz="0 1 0" />
                <limit lower="-1.57" upper="1.57" effort="1.0" velocity="10.0" />
        </joint>

        <!-- ================= link5 (was diffw_link) ================= -->
        <link name="link5">
                <inertial>
                        <origin xyz="4.5926E-06 1.4231E-06 0.0052114" rpy="0 0 0" />
                        <mass value="0.12065" />
                        <inertia ixx="6.1339E-05" ixy="8.9689E-10" ixz="1.7613E-08"
                                 iyy="6.1337E-05" iyz="5.4578E-09" izz="4.0162E-05" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_link.STL" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_link.STL" />
                        </geometry>
                </collision>
        </link>

        <!-- joint5: wrist roll (was diffw_yaw) -->
        <!-- NOTE: unconfirmed whether this SolidWorks joint is actually the -->
        <!-- wrist roll motion; verify against the physical arm. -->
        <joint name="joint5" type="revolute">
                <origin xyz="-7.4828E-05 0 0.063182" rpy="0 -0.0011843 0" />
                <parent link="link4" />
                <child link="link5" />
                <axis xyz="0 0 1" />
                <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="1.0" velocity="2.0" />
        </joint>

        <!-- ================================================================= -->
        <!-- End effector frames                                                -->
        <!-- ================================================================= -->

        <!-- Active minimal tool0: zero-offset from link5 so cartesian         -->
        <!-- controllers (end_effector_link: "tool0") keep working while the   -->
        <!-- gripper block below is disabled. Once the gripper geometry is     -->
        <!-- confirmed and re-enabled, move this joint's origin/parent down to -->
        <!-- sensor_link (see commented block) instead of link5.               -->
        <joint name="tool0_joint" type="fixed">
                <origin xyz="0 0 0" rpy="0 0 0" />
                <parent link="link5" />
                <child link="tool0" />
        </joint>
        <link name="tool0" />

        <!--
        ================================================================
        GRIPPER (from old xacro): commented out, toggle back on once
        confirmed against the real end effector. If re-enabled, DELETE
        the minimal tool0 block above and uncomment sensor_link/tool0
        below instead, along with removing "link5" -> "tool0" shortcut.

        <xacro:property name="joint_radius" value="0.02" />
        <xacro:property name="joint_length" value="0.03" />
        <xacro:property name="link5_length" value="0.1" />

        <material name="joint_part1">
                <color rgba="0.525 0.713 0.662 1.0"/>
        </material>
        <material name="joint_part2">
                <color rgba="0.462 0.196 0.411 1.0"/>
        </material>

        <visual name="gripper_base">
                <origin xyz="0 0 ${link5_length}" rpy="0 0 0" />
                <geometry>
                        <box size="${joint_radius * 2} ${joint_radius * 2.5} ${joint_length}"/>
                </geometry>
                <material name="joint_part1"/>
        </visual>
        <visual name="right_finger_1">
                <origin xyz="${joint_radius * 2} ${joint_radius} ${link5_length}" rpy="0 0 0.3" />
                <geometry>
                        <box size="${joint_length * 3} ${joint_radius * 0.8} ${joint_radius * 0.8}"/>
                </geometry>
                <material name="joint_part2"/>
        </visual>
        <visual name="right_finger_2">
                <origin xyz="${joint_radius * 3.75} ${joint_radius * 1.5} ${link5_length}" rpy="0 0 1.2" />
                <geometry>
                        <box size="${joint_length * 1.5} ${joint_radius * 0.8} ${joint_radius * 0.8}"/>
                </geometry>
                <material name="joint_part2"/>
        </visual>
        <visual name="left_finger_1">
                <origin xyz="${joint_radius * 2} -${joint_radius} ${link5_length}" rpy="0 0 -0.3" />
                <geometry>
                        <box size="${joint_length * 3} ${joint_radius * 0.8} ${joint_radius * 0.8}"/>
                </geometry>
                <material name="joint_part2"/>
        </visual>
        <visual name="left_finger_2">
                <origin xyz="${joint_radius * 3.75} -${joint_radius * 1.5} ${link5_length}" rpy="0 0 -1.2" />
                <geometry>
                        <box size="${joint_length * 1.5} ${joint_radius * 0.8} ${joint_radius * 0.8}"/>
                </geometry>
                <material name="joint_part2"/>
        </visual>

        <joint name="sensor_link_joint" type="fixed">
                <origin xyz="0 0 ${link5_length}" rpy="0 0 0"/>
                <parent link="link5"/>
                <child link="sensor_link"/>
        </joint>
        <link name="sensor_link"/>

        <joint name="tool0_joint" type="fixed">
                <origin xyz="${joint_radius * 3.5} 0 0" rpy="0 0 0"/>
                <parent link="sensor_link"/>
                <child link="tool0"/>
        </joint>
        <link name="tool0"/>

        <joint name="invalid_sensor_link_joint" type="fixed">
                <origin xyz="0 0 ${link5_length * 3}" rpy="0 0 0"/>
                <parent link="link5"/>
                <child link="invalid_sensor_link"/>
        </joint>
        <link name="invalid_sensor_link"/>

        <joint name="invalid_compliance_link_joint" type="fixed">
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <parent link="sensor_link"/>
                <child link="invalid_compliance_link"/>
        </joint>
        <link name="invalid_compliance_link"/>
        ================================================================
        -->

        <!-- ================================================================= -->
        <!-- Gazebo per-link material tags                                      -->
        <!-- ================================================================= -->

        <gazebo reference="base_link">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link1">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link2">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link3">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link4">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link5">
                <self_collide>true</self_collide>
        </gazebo>

</robot>
