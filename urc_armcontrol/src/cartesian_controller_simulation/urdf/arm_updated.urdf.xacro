<?xml version="1.0"?>

<robot name="arm_gz" xmlns:xacro="http://ros.org/wiki/xacro">

        <!--
        RoboNav Arm URDF - 5 degrees of freedom
        MERGED VERSION: geometry/origins/meshes/inertials now come from the
        SolidWorks export (Simplified_Arm.SLDASM.urdf), which has correct
        joint origins matching the CAD assembly mates. The ros2_control
        block and gz_ros2_control gazebo plugin are carried over from the
        original hand-written Gazebo xacro, with joint/link names renamed
        to match controller_manager_arm.yaml (joint1..joint5, arm_base_link,
        link1..link5, tool0).

        Joint mapping (SolidWorks name -> controller name):
          forearm_prismatic -> joint1   (base slide, prismatic)
          bicep_revolute    -> joint2   (shoulder pitch)
          forearm_revolute  -> joint3   (elbow pitch)
          diffw_pitch       -> joint4   (wrist pitch)
          diffw_yaw         -> joint5   (wrist roll)

        Link mapping:
          base_lineara -> arm_base_link
          bicep_base   -> link1
          bicep_link   -> link2
          forearm_link -> link3
          diffw_forearm -> link4
          link5 is now the claw palm, replacing diffw_link geometry

        NOTE: joint5 axis / diffw_yaw mapping to "wrist roll" is unconfirmed —
        verify against the physical arm.

        The end effector is a prototype parallel claw with one driven finger
        and one mimic finger. Dimensions and masses are placeholders, not CAD.
        Width = 2 * left_finger_joint position (meters); maximum width is 80 mm.
        tool0 is fixed to the palm at the grasp point, so finger motion does
        not add joints to the arm's Cartesian chain.
        -->

        <xacro:include filename="$(find cartesian_controller_simulation)/urdf/joint_gz.urdf.xacro"/>

        <!-- Prototype claw dimensions (meters, kilograms). -->
        <xacro:property name="claw_palm_x" value="0.03"/>
        <xacro:property name="claw_palm_y" value="0.10"/>
        <xacro:property name="claw_palm_z" value="0.02"/>
        <xacro:property name="claw_palm_mass" value="0.2"/>
        <xacro:property name="claw_finger_x" value="0.02"/>
        <xacro:property name="claw_finger_y" value="0.01"/>
        <xacro:property name="claw_finger_z" value="0.06"/>
        <xacro:property name="claw_finger_mass" value="0.05"/>
        <xacro:property name="claw_finger_travel" value="0.04"/>
        <!-- Uniform physical scale relative to the CAD export (metres).
             Constant density: mass scales with s^3 and inertia with s^5.
             The rover mount and angular joint limits are independent of scale. -->
        <xacro:arg name="arm_scale" default="0.5" />
        <xacro:property name="arm_scale" value="${float('$(arg arm_scale)')}" />

        <!-- ROS2 control interfaces -->
        <ros2_control name="cartesian_controller_simulation" type="system">

                <joint name="joint1"> <!-- base slide - prismatic -->
                        <command_interface name="position">
                                <param name="min">0</param>
                                <param name="max">${0.5 * arm_scale}</param>
                        </command_interface>
                        <command_interface name="velocity">
                                <param name="min">${-arm_scale}</param>
                                <param name="max">${arm_scale}</param>
                        </command_interface>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                        <state_interface name="effort"/>
                </joint>

                <xacro:joint_interface name="joint2" /> <!-- shoulder pitch -->
                <xacro:joint_interface name="joint3" /> <!-- elbow pitch -->
                <xacro:joint_interface name="joint4" /> <!-- wrist pitch -->
                <xacro:joint_interface name="joint5" /> <!-- wrist roll -->

                <!-- Humble gz_ros2_control: command only the left joint in
                     a gripper controller; the right joint follows it. -->
                <joint name="left_finger_joint">
                        <command_interface name="position">
                                <param name="min">0.0</param>
                                <param name="max">${claw_finger_travel}</param>
                        </command_interface>
                        <state_interface name="position">
                                <param name="initial_value">${claw_finger_travel / 2}</param>
                        </state_interface>
                        <state_interface name="velocity"/>
                </joint>
                <joint name="right_finger_joint">
                        <param name="mimic">left_finger_joint</param>
                        <param name="multiplier">1</param>
                        <command_interface name="position"/>
                        <state_interface name="position">
                                <param name="initial_value">${claw_finger_travel / 2}</param>
                        </state_interface>
                        <state_interface name="velocity"/>
                </joint>

                <hardware>
                        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>

        </ros2_control>

        <!-- Combined rover models supply their own controller-manager plugin. -->
        <xacro:arg name="standalone_sim" default="false"/>
        <xacro:if value="$(arg standalone_sim)">
        <gazebo>
        <!-- UNCOMMENT IF ONLY ARM SIM NEEDED -->
        <!-- Gazebo plugin to load controller manager -->
        <!-- <gazebo>
                <plugin filename="gz_ros2_control-system"
                        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                        <parameters>$(find cartesian_controller_simulation)/config/controller_manager_arm.yaml</parameters>
                </plugin>
        </gazebo>-->
        </xacro:if>
        
        <material name="base">
                <color rgba="0.79216 0.81961 0.93333 1" />
        </material>

        <!-- ================= arm_base_link (was base_lineara) ================= -->
        <link name="arm_base_link">
                <inertial>
                        <origin xyz="${3.579E-06 * arm_scale} ${0.22158 * arm_scale} ${0.010673 * arm_scale}" rpy="0 0 0" />
                        <mass value="${1.3141 * arm_scale**3}" />
                        <inertia ixx="${0.034947 * arm_scale**5}" ixy="${-1.0032E-07 * arm_scale**5}" ixz="${-4.9223E-09 * arm_scale**5}"
                                 iyy="${0.0025144 * arm_scale**5}" iyz="${3.7387E-07 * arm_scale**5}" izz="${0.037389 * arm_scale**5}" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/base_lineara.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/base_lineara.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                </collision>
        </link>

        <!-- ================= link1 (was bicep_base) ================= -->
        <link name="link1">
                <inertial>
                        <origin xyz="${-2.909E-05 * arm_scale} ${0.072285 * arm_scale} ${0.04786 * arm_scale}" rpy="0 0 0" />
                        <mass value="${0.80928 * arm_scale**3}" />
                        <inertia ixx="${0.001288 * arm_scale**5}" ixy="${-2.9097E-08 * arm_scale**5}" ixz="${2.9394E-09 * arm_scale**5}"
                                 iyy="${0.0024023 * arm_scale**5}" iyz="${-3.1525E-09 * arm_scale**5}" izz="${0.0018264 * arm_scale**5}" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_base.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_base.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                </collision>
        </link>

        <!-- joint1: base slide (was forearm_prismatic) -->
        <joint name="joint1" type="prismatic">
                <origin xyz="0 0 ${0.03135 * arm_scale}" rpy="0 0 0" />
                <parent link="arm_base_link" />
                <child link="link1" />
                <axis xyz="0 1 0" />
                <limit lower="0" upper="${0.5 * arm_scale}" effort="100" velocity="${arm_scale}" />
        </joint>

        <!-- ================= link2 (was bicep_link) ================= -->
        <link name="link2">
                <inertial>
                        <origin xyz="${-8.0298E-05 * arm_scale} ${0.028836 * arm_scale} ${0.082763 * arm_scale}" rpy="0 0 0" />
                        <mass value="${1.5004 * arm_scale**3}" />
                        <inertia ixx="${0.005463 * arm_scale**5}" ixy="${-3.5399E-07 * arm_scale**5}" ixz="${-1.6306E-05 * arm_scale**5}"
                                 iyy="${0.0069551 * arm_scale**5}" iyz="${-5.814E-07 * arm_scale**5}" izz="${0.001901 * arm_scale**5}" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_link.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/bicep_link.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                </collision>
        </link>

        <!-- joint2: shoulder pitch (was bicep_revolute) -->
        <joint name="joint2" type="revolute">
                <origin xyz="0 ${0.076091 * arm_scale} ${0.12103 * arm_scale}" rpy="0 0 0" />
                <parent link="link1" />
                <child link="link2" />
                <axis xyz="0 1 0" />
                <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="30.0" velocity="10.0" />
        </joint>

        <!-- ================= link3 (was forearm_link) ================= -->
        <link name="link3">
                <inertial>
                        <origin xyz="${-0.00011008 * arm_scale} ${-0.025553 * arm_scale} ${0.076716 * arm_scale}" rpy="0 0 0" />
                        <mass value="${1.601 * arm_scale**3}" />
                        <inertia ixx="${0.0051728 * arm_scale**5}" ixy="${-2.2245E-06 * arm_scale**5}" ixz="${7.8401E-06 * arm_scale**5}"
                                 iyy="${0.0064253 * arm_scale**5}" iyz="${1.9188E-08 * arm_scale**5}" izz="${0.0018615 * arm_scale**5}" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/forearm_link.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/forearm_link.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                </collision>
        </link>

        <!-- joint3: elbow pitch (was forearm_revolute) -->
        <joint name="joint3" type="revolute">
                <origin xyz="${-0.00050763 * arm_scale} ${0.068262 * arm_scale} ${0.42862 * arm_scale}" rpy="0 0 0" />
                <parent link="link2" />
                <child link="link3" />
                <axis xyz="0 1 0" />
                <limit lower="${-pi}" upper="${pi}" effort="30.0" velocity="10.0" />
        </joint>

        <!-- ================= link4 (was diffw_forearm) ================= -->
        <link name="link4">
                <inertial>
                        <origin xyz="${-1.4843E-05 * arm_scale} ${5.7115E-06 * arm_scale} ${0.0050339 * arm_scale}" rpy="0 0 0" />
                        <mass value="${0.27656 * arm_scale**3}" />
                        <inertia ixx="${9.9333E-05 * arm_scale**5}" ixy="${5.7444E-09 * arm_scale**5}" ixz="${-5.0297E-08 * arm_scale**5}"
                                 iyy="${0.00012995 * arm_scale**5}" iyz="${5.1554E-10 * arm_scale**5}" izz="${9.7766E-05 * arm_scale**5}" />
                </inertial>
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_forearm.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                        <material name="base" />
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0" />
                        <geometry>
                                <mesh filename="package://cartesian_controller_simulation/meshes/diffw_forearm.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
                        </geometry>
                </collision>
        </link>

        <!-- joint4: wrist pitch (was diffw_pitch) -->
        <joint name="joint4" type="revolute">
                <origin xyz="${-0.00047153 * arm_scale} ${-0.068263 * arm_scale} ${0.39814 * arm_scale}" rpy="0 0 0" />
                <parent link="link3" />
                <child link="link4" />
                <axis xyz="0 1 0" />
                <limit lower="-1.57" upper="1.57" effort="8.0" velocity="10.0" />
        </joint>

        <!-- Box geometry with physically consistent inertia about its center.
             z offsets the box center from the link frame along the tool axis. -->
        <xacro:macro name="claw_box" params="name sx sy sz mass z">
                <link name="${name}">
                        <inertial>
                                <origin xyz="0 0 ${z}"/>
                                <mass value="${mass}"/>
                                <inertia ixx="${mass * (sy*sy + sz*sz) / 12}"
                                         iyy="${mass * (sx*sx + sz*sz) / 12}"
                                         izz="${mass * (sx*sx + sy*sy) / 12}"
                                         ixy="0" ixz="0" iyz="0"/>
                        </inertial>
                        <visual>
                                <origin xyz="0 0 ${z}"/>
                                <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
                                <material name="my_custom_color">
                                        <color rgba="0.8 0.2 0.2 1.0"/>
                                </material>
                        </visual>
                        <collision name="${name}_collision">
                                <origin xyz="0 0 ${z}"/>
                                <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
                        </collision>
                </link>
        </xacro:macro>

        <!-- link5 retains the CAD wrist attachment frame; the palm extends +Z. -->
        <xacro:claw_box name="link5"
                        sx="${claw_palm_x}" sy="${claw_palm_y}" sz="${claw_palm_z}"
                        mass="${claw_palm_mass}" z="${claw_palm_z / 2}"/>

        <!-- joint5: wrist roll (was diffw_yaw) -->
        <!-- NOTE: unconfirmed whether this SolidWorks joint is actually the -->
        <!-- wrist roll motion; verify against the physical arm. -->
        <joint name="joint5" type="revolute">
                <origin xyz="${-7.4828E-05 * arm_scale} 0 ${0.063182 * arm_scale}" rpy="0 -0.0011843 0" />
                <parent link="link4" />
                <child link="link5" />
                <axis xyz="0 0 1" />
                <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="8.0" velocity="2.0" />
        </joint>

        <!-- Fingers extend +Z and open along opposite Y axes. At q=0 their
             inner faces meet; equal positive joint positions open the claw. -->
        <xacro:claw_box name="left_finger"
                        sx="${claw_finger_x}" sy="${claw_finger_y}" sz="${claw_finger_z}"
                        mass="${claw_finger_mass}" z="${claw_finger_z / 2}"/>
        <xacro:claw_box name="right_finger"
                        sx="${claw_finger_x}" sy="${claw_finger_y}" sz="${claw_finger_z}"
                        mass="${claw_finger_mass}" z="${claw_finger_z / 2}"/>

        <joint name="left_finger_joint" type="prismatic">
                <parent link="link5"/>
                <child link="left_finger"/>
                <origin xyz="0 ${claw_finger_y / 2} ${claw_palm_z}"/>
                <axis xyz="0 1 0"/>
                <limit lower="0" upper="${claw_finger_travel}" effort="20" velocity="0.02"/>
        </joint>
        <joint name="right_finger_joint" type="prismatic">
                <parent link="link5"/>
                <child link="right_finger"/>
                <origin xyz="0 ${-claw_finger_y / 2} ${claw_palm_z}"/>
                <axis xyz="0 -1 0"/>
                <limit lower="0" upper="${claw_finger_travel}" effort="20" velocity="0.02"/>
                <mimic joint="left_finger_joint" multiplier="1" offset="0"/>
        </joint>

        <!-- Grasp point is centered between the fingers, 10 mm behind tips. -->
        <joint name="tool0_joint" type="fixed">
                <origin xyz="0 0 ${claw_palm_z + claw_finger_z - 0.01}"/>
                <parent link="link5"/>
                <child link="tool0"/>
        </joint>
        <link name="tool0"/>

        <!-- Independent contact feedback for each finger. The simulation world
             must load Gazebo's Contact system; ROS topics require a bridge.
             URDF-to-SDF conversion appends _collision to the collision names. -->
        <gazebo reference="left_finger">
                <sensor name="left_finger_contact" type="contact">
                        <always_on>true</always_on>
                        <update_rate>100</update_rate>
                        <topic>/gripper/left_contact</topic>
                        <contact>
                                <collision>left_finger_collision_collision</collision>
                        </contact>
                </sensor>
        </gazebo>
        <gazebo reference="right_finger">
                <sensor name="right_finger_contact" type="contact">
                        <always_on>true</always_on>
                        <update_rate>100</update_rate>
                        <topic>/gripper/right_contact</topic>
                        <contact>
                                <collision>right_finger_collision_collision</collision>
                        </contact>
                </sensor>
        </gazebo>

        <!-- ================================================================= -->
        <!-- Gazebo per-link material tags                                      -->
        <!-- ================================================================= -->

        <gazebo reference="arm_base_link">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link1">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link2">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link3">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link4">
                <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="link5">
                <self_collide>true</self_collide>
        </gazebo>

</robot>
