<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>urc_sim</name>
  <version>0.0.0</version>
  <description>Simulation-only nodes that connect ROS interfaces to Gazebo</description>
  <maintainer email="rafaeloliveiraprep@gmail.com">Rafael Oliveira</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>urc_msgs</depend>
  <depend condition="$GZ_VERSION == fortress or $GZ_VERSION == ''">ignition-msgs8</depend>
  <depend condition="$GZ_VERSION == fortress or $GZ_VERSION == ''">ignition-transport11</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
