# Initial rendezvous in the configured map frame.
geometry_msgs/PoseStamped waypoint
---
uint16 SUCCESS=0
uint16 NAVIGATION_FAILED=1
uint16 TARGET_LOST=2
uint16 TOOL_FAILED=3
uint16 CANCELED=4
uint16 TIMEOUT=5
uint16 error_code
string message
---
string state
float32 distance_to_astronaut
bool tool_placeholder_enabled
