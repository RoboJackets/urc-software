# Navigate to the search area and approach one URC marker.
uint8 ARUCO_1=1
uint8 ARUCO_2=2
geometry_msgs/PoseStamped waypoint
uint8 marker_id
---
uint16 SUCCESS=0
uint16 NAVIGATION_FAILED=1
uint16 TARGET_NOT_FOUND=2
uint16 APPROACH_FAILED=3
uint16 CANCELED=4
uint16 TIMEOUT=5
uint16 error_code
string message
bool has_aruco_pose
geometry_msgs/PoseStamped aruco_pose
---
string state
float32 distance_to_goal
uint16 replan_count
