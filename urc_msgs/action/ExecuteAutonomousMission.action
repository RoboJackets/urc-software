# Navigate to a target in the configured map frame; ArUco refinement is optional.
geometry_msgs/PoseStamped waypoint
---
uint16 SUCCESS=0
uint16 NAVIGATION_FAILED=1
uint16 CANCELED=4
uint16 TIMEOUT=5
uint16 error_code
string message
bool has_aruco_pose
geometry_msgs/PoseStamped aruco_pose
---
string state
float32 distance_to_goal
uint16 replan_count
