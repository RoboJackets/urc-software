# Request: spiral center, outer search radius, and optional spacing overrides (<= 0 uses server defaults).
geometry_msgs/PoseStamped center
float64 search_radius
float64 track_spacing
float64 waypoint_spacing
---
uint16 SUCCESS=0
uint16 INVALID_REQUEST=1
uint16 FAILURE=2
nav_msgs/Path path
float64 track_spacing
float64 path_length
uint16 error_code
