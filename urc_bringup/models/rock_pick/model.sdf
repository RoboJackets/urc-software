<?xml version="1.0"?>
<sdf version="1.8">
  <!-- Lies flat in the model XY plane: handle along +Y, head along X at the top. -->
  <model name="rock_pick">
    <link name="body">
      <inertial>
        <pose>0 0.06 0 0 0 0</pose>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0062</ixx>
          <iyy>0.0019</iyy>
          <izz>0.0079</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="handle_collision">
        <pose>0 0.01 0 0 0 0</pose>
        <geometry><box><size>0.035 0.34 0.03</size></box></geometry>
      </collision>
      <collision name="head_collision">
        <pose>0.035 0.19 0 0 0 0</pose>
        <geometry><box><size>0.19 0.03 0.03</size></box></geometry>
      </collision>

      <visual name="shank">
        <pose>0 0.09 0 0 0 0</pose>
        <geometry><box><size>0.022 0.18 0.018</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.72 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <visual name="hammer_face">
        <pose>-0.03 0.19 0 0 0 0</pose>
        <geometry><box><size>0.06 0.03 0.03</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.72 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <visual name="pick">
        <pose>0.065 0.195 0 0 0 -0.15</pose>
        <geometry><box><size>0.13 0.016 0.02</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.72 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <visual name="grip">
        <pose>0 -0.08 0 0 0 0</pose>
        <geometry><box><size>0.034 0.16 0.028</size></box></geometry>
        <material>
          <ambient>1.0 0.82 0.0 1</ambient>
          <diffuse>1.0 0.82 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="grip_collar">
        <pose>0 0.005 0 0 0 0</pose>
        <geometry><box><size>0.036 0.012 0.03</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="grip_end">
        <pose>0 -0.15 0 0 0 0</pose>
        <geometry><box><size>0.038 0.03 0.031</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
