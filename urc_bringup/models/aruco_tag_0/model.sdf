<?xml version="1.0"?>
<sdf version="1.8">
  <model name="aruco_tag_0">

    <!-- Fixed ArUco marker: does not fall or interact with rover physics. -->
    <static>true</static>

    <link name="tag_link">

      <visual name="aruco_tag_visual">

        <geometry>
          <box>
            <!-- 50 cm x 50 cm marker, 2 mm thick for reliable detection at 4 m -->
            <size>0.50 0.002 0.50</size>
          </box>
        </geometry>

        <material>
          <pbr>
            <metal>
              <!-- The generated DICT_6X6_50 marker, ID 23. -->
              <albedo_map>
                model://aruco_tag_0/materials/textures/6x6_aruco_tag.png
              </albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>

        <cast_shadows>false</cast_shadows>

      </visual>

    </link>

  </model>
</sdf>