<?xml version="1.0"?>
<sdf version="1.8">
  <model name="aruco_tag_0">

    <!-- Keep the tag fixed in the world -->
    <static>true</static>

    <link name="tag_link">

      <visual name="aruco_tag_visual">

        <geometry>
          <plane>
            <normal>0 1 0</normal>
            <size>0.50 0.50</size>
          </plane>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>

          <pbr>
            <metal>
              <!-- The simulated marker image. Its encoded ID is determined
                   from the camera image by aruco_detector.py. -->
              <albedo_map>model://aruco_tag_0/materials/textures/6x6_aruco_tag.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>

        <cast_shadows>false</cast_shadows>

      </visual>

    </link>
  </model>
</sdf>
