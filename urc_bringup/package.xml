<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>urc_bringup</name>
  <version>0.0.0</version>
  <description>Package to launch all urc packages</description>
  <maintainer email="mrinal@gatech.edu"> Mrinal Jain </maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rosbridge_server</depend>
  <depend>urc_msgs</depend>
  <depend>urc_controllers</depend>
  <depend>urc_localization</depend>
  <depend>urc_path_planning</depend>
  <depend>urc_perception</depend>
  <depend>urc_platform</depend>
  <depend>urc_state_machine</depend>
  <depend>urc_trajectory_following</depend>
  <depend>ros_gz</depend>
  <depend>effort_controllers</depend>
  <depend>grid_map_rviz_plugin</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
